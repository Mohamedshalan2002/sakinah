{"surah":37,"verses":[{"v":1,"t":"وَٱلصَّـٰٓفَّـٰتِ صَفّٗا","juz":23,"page":446,"sajda":false},{"v":2,"t":"فَٱلزَّـٰجِرَٰتِ زَجۡرٗا","juz":23,"page":446,"sajda":false},{"v":3,"t":"فَٱلتَّـٰلِيَٰتِ ذِكۡرًا","juz":23,"page":446,"sajda":false},{"v":4,"t":"إِنَّ إِلَٰهَكُمۡ لَوَٰحِدٞ","juz":23,"page":446,"sajda":false},{"v":5,"t":"رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا وَرَبُّ ٱلۡمَشَٰرِقِ","juz":23,"page":446,"sajda":false},{"v":6,"t":"إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنۡيَا بِزِينَةٍ ٱلۡكَوَاكِبِ","juz":23,"page":446,"sajda":false},{"v":7,"t":"وَحِفۡظٗا مِّن كُلِّ شَيۡطَٰنٖ مَّارِدٖ","juz":23,"page":446,"sajda":false},{"v":8,"t":"لَّا يَسَّمَّعُونَ إِلَى ٱلۡمَلَإِ ٱلۡأَعۡلَىٰ وَيُقۡذَفُونَ مِن كُلِّ جَانِبٖ","juz":23,"page":446,"sajda":false},{"v":9,"t":"دُحُورٗاۖ وَلَهُمۡ عَذَابٞ وَاصِبٌ","juz":23,"page":446,"sajda":false},{"v":10,"t":"إِلَّا مَنۡ خَطِفَ ٱلۡخَطۡفَةَ فَأَتۡبَعَهُۥ شِهَابٞ ثَاقِبٞ","juz":23,"page":446,"sajda":false},{"v":11,"t":"فَٱسۡتَفۡتِهِمۡ أَهُمۡ أَشَدُّ خَلۡقًا أَم مَّنۡ خَلَقۡنَآۚ إِنَّا خَلَقۡنَٰهُم مِّن طِينٖ لَّازِبِۭ","juz":23,"page":446,"sajda":false},{"v":12,"t":"بَلۡ عَجِبۡتَ وَيَسۡخَرُونَ","juz":23,"page":446,"sajda":false},{"v":13,"t":"وَإِذَا ذُكِّرُواْ لَا يَذۡكُرُونَ","juz":23,"page":446,"sajda":false},{"v":14,"t":"وَإِذَا رَأَوۡاْ ءَايَةٗ يَسۡتَسۡخِرُونَ","juz":23,"page":446,"sajda":false},{"v":15,"t":"وَقَالُوٓاْ إِنۡ هَٰذَآ إِلَّا سِحۡرٞ مُّبِينٌ","juz":23,"page":446,"sajda":false},{"v":16,"t":"أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ","juz":23,"page":446,"sajda":false},{"v":17,"t":"أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ","juz":23,"page":446,"sajda":false},{"v":18,"t":"قُلۡ نَعَمۡ وَأَنتُمۡ دَٰخِرُونَ","juz":23,"page":446,"sajda":false},{"v":19,"t":"فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ فَإِذَا هُمۡ يَنظُرُونَ","juz":23,"page":446,"sajda":false},{"v":20,"t":"وَقَالُواْ يَٰوَيۡلَنَا هَٰذَا يَوۡمُ ٱلدِّينِ","juz":23,"page":446,"sajda":false},{"v":21,"t":"هَٰذَا يَوۡمُ ٱلۡفَصۡلِ ٱلَّذِي كُنتُم بِهِۦ تُك