{"surah":75,"verses":[{"v":1,"t":"لَآ أُقۡسِمُ بِيَوۡمِ ٱلۡقِيَٰمَةِ","juz":29,"page":577,"sajda":false},{"v":2,"t":"وَلَآ أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ","juz":29,"page":577,"sajda":false},{"v":3,"t":"أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ","juz":29,"page":577,"sajda":false},{"v":4,"t":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥ","juz":29,"page":577,"sajda":false},{"v":5,"t":"بَلۡ يُرِيدُ ٱلۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ","juz":29,"page":577,"sajda":false},{"v":6,"t":"يَسۡـَٔلُ أَيَّانَ يَوۡمُ ٱلۡقِيَٰمَةِ","juz":29,"page":577,"sajda":false},{"v":7,"t":"فَإِذَا بَرِقَ ٱلۡبَصَرُ","juz":29,"page":577,"sajda":false},{"v":8,"t":"وَخَسَفَ ٱلۡقَمَرُ","juz":29,"page":577,"sajda":false},{"v":9,"t":"وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ","juz":29,"page":577,"sajda":false},{"v":10,"t":"يَقُولُ ٱلۡإِنسَٰنُ يَوۡمَئِذٍ أَيۡنَ ٱلۡمَفَرُّ","juz":29,"page":577,"sajda":false},{"v":11,"t":"كَلَّا لَا وَزَرَ","juz":29,"page":577,"sajda":false},{"v":12,"t":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمُسۡتَقَرُّ","juz":29,"page":577,"sajda":false},{"v":13,"t":"يُنَبَّؤُاْ ٱلۡإِنسَٰنُ يَوۡمَئِذِۭ بِمَا قَدَّمَ وَأَخَّرَ","juz":29,"page":577,"sajda":false},{"v":14,"t":"بَلِ ٱلۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةٞ","juz":29,"page":577,"sajda":false},{"v":15,"t":"وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ","juz":29,"page":577,"sajda":false},{"v":16,"t":"لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦٓ","juz":29,"page":577,"sajda":false},{"v":17,"t":"إِنَّ عَلَيۡنَا جَمۡعَهُۥ وَقُرۡءَانَهُۥ","juz":29,"page":577,"sajda":false},{"v":18,"t":"فَإِذَا قَرَأۡنَٰهُ فَٱتَّبِعۡ قُرۡءَانَهُۥ","juz":29,"page":577,"sajda":false},{"v":19,"t":"ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ","juz":29,"page":577,"sajda":false},{"v":20,"t":"كَلَّا بَلۡ تُحِبُّونَ ٱلۡعَاجِلَةَ","juz":29,"page":578,"sajda":false},{"v":21,"t":"وَتَذَرُونَ ٱلۡأٓخِرَةَ","juz":29,"page":578,"sajda":false},{"v":22,"t":"وُجُوهٞ يَوۡمَئِذٖ نَّاضِرَةٌ","juz":29,"page":578,"sajda":false},{"v":23,"t":"إِلَىٰ رَبِّهَا نَاظِرَةٞ","juz":29,"page":578,"sajda":false},{"v":24,"t":"وَوُجُوهٞ يَوۡمَئِذِۭ بَاسِرَةٞ","juz":29,"page":578,"sajda":false},{"v":25,"t":"تَظُنُّ أَن يُفۡعَلَ بِهَا فَاقِرَةٞ","juz":29,"page":578,"sajda":false},{"v":26,"t":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِيَ","juz":29,"page":578,"sajda":false},{"v":27,"t":"وَقِيلَ مَنۡۜ رَاقٖ","juz":29,"page":578,"sajda":false},{"v":28,"t":"وَظَنَّ أَنَّهُ ٱلۡفِرَاقُ","juz":29,"page":578,"sajda":false},{"v":29,"t":"وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","juz":29,"page":578,"sajda":false},{"v":30,"t":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمَسَاقُ","juz":29,"page":578,"sajda":false},{"v":31,"t":"فَلَا صَدَّقَ وَلَا صَلَّىٰ","juz":29,"page":578,"sajda":false},{"v":32,"t":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ","juz":29,"page":578,"sajda":false},{"v":33,"t":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهۡلِهِۦ يَتَمَطَّىٰٓ","juz":29,"page":578,"sajda":false},{"v":34,"t":"أَوۡلَىٰ لَكَ فَأَوۡلَىٰ","juz":29,"page":578,"sajda":false},{"v":35,"t":"ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلَىٰٓ","juz":29,"page":578,"sajda":false},{"v":36,"t":"أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَن يُتۡرَكَ سُدًى","juz":29,"page":578,"sajda":false},{"v":37,"t":"أَلَمۡ يَكُ نُطۡفَةٗ مِّن مَّنِيّٖ يُمۡنَىٰ","juz":29,"page":578,"sajda":false},{"v":38,"t":"ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوَّىٰ","juz":29,"page":578,"sajda":false},{"v":39,"t":"فَجَعَلَ مِنۡهُ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ","juz":29,"page":578,"sajda":false},{"v":40,"t":"أَلَيۡسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحۡـِۧيَ ٱلۡمَوۡتَىٰ","juz":29,"page":578,"sajda":false}]}