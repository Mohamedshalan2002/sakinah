{"surah":82,"verses":[{"v":1,"t":"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ","juz":30,"page":587,"sajda":false},{"v":2,"t":"وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ","juz":30,"page":587,"sajda":false},{"v":3,"t":"وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ","juz":30,"page":587,"sajda":false},{"v":4,"t":"وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ","juz":30,"page":587,"sajda":false},{"v":5,"t":"عَلِمَتۡ نَفۡسٞ مَّا قَدَّمَتۡ وَأَخَّرَتۡ","juz":30,"page":587,"sajda":false},{"v":6,"t":"يَـٰٓأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ","juz":30,"page":587,"sajda":false},{"v":7,"t":"ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","juz":30,"page":587,"sajda":false},{"v":8,"t":"فِيٓ أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَ","juz":30,"page":587,"sajda":false},{"v":9,"t":"كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ","juz":30,"page":587,"sajda":false},{"v":10,"t":"وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ","juz":30,"page":587,"sajda":false},{"v":11,"t":"كِرَامٗا كَٰتِبِينَ","juz":30,"page":587,"sajda":false},{"v":12,"t":"يَعۡلَمُونَ مَا تَفۡعَلُونَ","juz":30,"page":587,"sajda":false},{"v":13,"t":"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٖ","juz":30,"page":587,"sajda":false},{"v":14,"t":"وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمٖ","juz":30,"page":587,"sajda":false},{"v":15,"t":"يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ","juz":30,"page":587,"sajda":false},{"v":16,"t":"وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ","juz":30,"page":587,"sajda":false},{"v":17,"t":"وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ","juz":30,"page":587,"sajda":false},{"v":18,"t":"ثُمَّ مَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ","juz":30,"page":587,"sajda":false},{"v":19,"t":"يَوۡمَ لَا تَمۡلِكُ نَفۡسٞ لِّنَفۡسٖ شَيۡـٔٗاۖ وَٱلۡأَمۡرُ يَوۡمَئِذٖ لِّلَّهِ","juz":30,"page":587,"sajda":false}]}