{"surah":83,"verses":[{"v":1,"t":"وَيۡلٞ لِّلۡمُطَفِّفِينَ","juz":30,"page":587,"sajda":false},{"v":2,"t":"ٱلَّذِينَ إِذَا ٱكۡتَالُواْ عَلَى ٱلنَّاسِ يَسۡتَوۡفُونَ","juz":30,"page":587,"sajda":false},{"v":3,"t":"وَإِذَا كَالُوهُمۡ أَو وَّزَنُوهُمۡ يُخۡسِرُونَ","juz":30,"page":587,"sajda":false},{"v":4,"t":"أَلَا يَظُنُّ أُوْلَـٰٓئِكَ أَنَّهُم مَّبۡعُوثُونَ","juz":30,"page":587,"sajda":false},{"v":5,"t":"لِيَوۡمٍ عَظِيمٖ","juz":30,"page":587,"sajda":false},{"v":6,"t":"يَوۡمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلۡعَٰلَمِينَ","juz":30,"page":587,"sajda":false},{"v":7,"t":"كَلَّآ إِنَّ كِتَٰبَ ٱلۡفُجَّارِ لَفِي سِجِّينٖ","juz":30,"page":588,"sajda":false},{"v":8,"t":"وَمَآ أَدۡرَىٰكَ مَا سِجِّينٞ","juz":30,"page":588,"sajda":false},{"v":9,"t":"كِتَٰبٞ مَّرۡقُومٞ","juz":30,"page":588,"sajda":false},{"v":10,"t":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","juz":30,"page":588,"sajda":false},{"v":11,"t":"ٱلَّذِينَ يُكَذِّبُونَ بِيَوۡمِ ٱلدِّينِ","juz":30,"page":588,"sajda":false},{"v":12,"t":"وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعۡتَدٍ أَثِيمٍ","juz":30,"page":588,"sajda":false},{"v":13,"t":"إِذَا تُتۡلَىٰ عَلَيۡهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلۡأَوَّلِينَ","juz":30,"page":588,"sajda":false},{"v":14,"t":"كَلَّاۖ بَلۡۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُواْ يَكۡسِبُونَ","juz":30,"page":588,"sajda":false},{"v":15,"t":"كَلَّآ إِنَّهُمۡ عَن رَّبِّهِمۡ يَوۡمَئِذٖ لَّمَحۡجُوبُونَ","juz":30,"page":588,"sajda":false},{"v":16,"t":"ثُمَّ إِنَّهُمۡ لَصَالُواْ ٱلۡجَحِيمِ","juz":30,"page":588,"sajda":false},{"v":17,"t":"ثُمَّ يُقَالُ هَٰذَا ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ","juz":30,"page":588,"sajda":false},{"v":18,"t":"كَلَّآ إِنَّ كِتَٰبَ ٱلۡأَبۡرَارِ لَفِي عِلِّيِّينَ","juz":30,"page":588,"sajda":false},{"v":19,"t":"وَمَآ أَدۡرَىٰكَ مَا عِلِّيُّونَ","juz":30,"page":588,"sajda":false},{"v":20,"t":"كِتَٰبٞ مَّرۡقُومٞ","juz":30,"page":588,"sajda":false},{"v":21,"t":"يَشۡهَدُهُ ٱلۡمُقَرَّبُونَ","juz":30,"page":588,"sajda":false},{"v":22,"t":"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٍ","juz":30,"page":588,"sajda":false},{"v":23,"t":"عَلَى ٱلۡأَرَآئِكِ يَنظُرُونَ","juz":30,"page":588,"sajda":false},{"v":24,"t":"تَعۡرِفُ فِي وُجُوهِهِمۡ نَضۡرَةَ ٱلنَّعِيمِ","juz":30,"page":588,"sajda":false},{"v":25,"t":"يُسۡقَوۡنَ مِن رَّحِيقٖ مَّخۡتُومٍ","juz":30,"page":588,"sajda":false},{"v":26,"t":"خِتَٰمُهُۥ مِسۡكٞۚ وَفِي ذَٰلِكَ فَلۡيَتَنَافَسِ ٱلۡمُتَنَٰفِسُونَ","juz":30,"page":588,"sajda":false},{"v":27,"t":"وَمِزَاجُهُۥ مِن تَسۡنِيمٍ","juz":30,"page":588,"sajda":false},{"v":28,"t":"عَيۡنٗا يَشۡرَبُ بِهَا ٱلۡمُقَرَّبُونَ","juz":30,"page":588,"sajda":false},{"v":29,"t":"إِنَّ ٱلَّذِينَ أَجۡرَمُواْ كَانُواْ مِنَ ٱلَّذِينَ ءَامَنُواْ يَضۡحَكُونَ","juz":30,"page":588,"sajda":false},{"v":30,"t":"وَإِذَا مَرُّواْ بِهِمۡ يَتَغَامَزُونَ","juz":30,"page":588,"sajda":false},{"v":31,"t":"وَإِذَا ٱنقَلَبُوٓاْ إِلَىٰٓ أَهۡلِهِمُ ٱنقَلَبُواْ فَكِهِينَ","juz":30,"page":588,"sajda":false},{"v":32,"t":"وَإِذَا رَأَوۡهُمۡ قَالُوٓاْ إِنَّ هَـٰٓؤُلَآءِ لَضَآلُّونَ","juz":30,"page":588,"sajda":false},{"v":33,"t":"وَمَآ أُرۡسِلُواْ عَلَيۡهِمۡ حَٰفِظِينَ","juz":30,"page":588,"sajda":false},{"v":34,"t":"فَٱلۡيَوۡمَ ٱلَّذِينَ ءَامَنُواْ مِنَ ٱلۡكُفَّارِ يَضۡحَكُونَ","juz":30,"page":588,"sajda":false},{"v":35,"t":"عَلَى ٱلۡأَرَآئِكِ يَنظُرُونَ","juz":30,"page":589,"sajda":false},{"v":36,"t":"هَلۡ ثُوِّبَ ٱلۡكُفَّارُ مَا كَانُواْ يَفۡعَلُونَ","juz":30,"page":589,"sajda":false}]}