{"surah":78,"verses":[{"v":1,"t":"عَمَّ يَتَسَآءَلُونَ","juz":30,"page":582,"sajda":false},{"v":2,"t":"عَنِ ٱلنَّبَإِ ٱلۡعَظِيمِ","juz":30,"page":582,"sajda":false},{"v":3,"t":"ٱلَّذِي هُمۡ فِيهِ مُخۡتَلِفُونَ","juz":30,"page":582,"sajda":false},{"v":4,"t":"كَلَّا سَيَعۡلَمُونَ","juz":30,"page":582,"sajda":false},{"v":5,"t":"ثُمَّ كَلَّا سَيَعۡلَمُونَ","juz":30,"page":582,"sajda":false},{"v":6,"t":"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَٰدٗا","juz":30,"page":582,"sajda":false},{"v":7,"t":"وَٱلۡجِبَالَ أَوۡتَادٗا","juz":30,"page":582,"sajda":false},{"v":8,"t":"وَخَلَقۡنَٰكُمۡ أَزۡوَٰجٗا","juz":30,"page":582,"sajda":false},{"v":9,"t":"وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتٗا","juz":30,"page":582,"sajda":false},{"v":10,"t":"وَجَعَلۡنَا ٱلَّيۡلَ لِبَاسٗا","juz":30,"page":582,"sajda":false},{"v":11,"t":"وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشٗا","juz":30,"page":582,"sajda":false},{"v":12,"t":"وَبَنَيۡنَا فَوۡقَكُمۡ سَبۡعٗا شِدَادٗا","juz":30,"page":582,"sajda":false},{"v":13,"t":"وَجَعَلۡنَا سِرَاجٗا وَهَّاجٗا","juz":30,"page":582,"sajda":false},{"v":14,"t":"وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَٰتِ مَآءٗ ثَجَّاجٗا","juz":30,"page":582,"sajda":false},{"v":15,"t":"لِّنُخۡرِجَ بِهِۦ حَبّٗا وَنَبَاتٗا","juz":30,"page":582,"sajda":false},{"v":16,"t":"وَجَنَّـٰتٍ أَلۡفَافًا","juz":30,"page":582,"sajda":false},{"v":17,"t":"إِنَّ يَوۡمَ ٱلۡفَصۡلِ كَانَ مِيقَٰتٗا","juz":30,"page":582,"sajda":false},{"v":18,"t":"يَوۡمَ يُنفَخُ فِي ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجٗا","juz":30,"page":582,"sajda":false},{"v":19,"t":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتۡ أَبۡوَٰبٗا","juz":30,"page":582,"sajda":false},{"v":20,"t":"وَسُيِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا","juz":30,"page":582,"sajda":false},{"v":21,"t":"إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادٗا","juz":30,"page":582,"sajda":false},{"v":22,"t":"لِّلطَّـٰغِينَ مَـَٔابٗا","juz":30,"page":582,"sajda":false},{"v":23,"t":"لَّـٰبِثِينَ فِيهَآ أَحۡقَابٗا","juz":30,"page":582,"sajda":false},{"v":24,"t":"لَّا يَذُوقُونَ فِيهَا بَرۡدٗا وَلَا شَرَابًا","juz":30,"page":582,"sajda":false},{"v":25,"t":"إِلَّا حَمِيمٗا وَغَسَّاقٗا","juz":30,"page":582,"sajda":false},{"v":26,"t":"جَزَآءٗ وِفَاقًا","juz":30,"page":582,"sajda":false},{"v":27,"t":"إِنَّهُمۡ كَانُواْ لَا يَرۡجُونَ حِسَابٗا","juz":30,"page":582,"sajda":false},{"v":28,"t":"وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّابٗا","juz":30,"page":582,"sajda":false},{"v":29,"t":"وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ كِتَٰبٗا","juz":30,"page":582,"sajda":false},{"v":30,"t":"فَذُوقُواْ فَلَن نَّزِيدَكُمۡ إِلَّا عَذَابًا","juz":30,"page":582,"sajda":false},{"v":31,"t":"إِنَّ لِلۡمُتَّقِينَ مَفَازًا","juz":30,"page":583,"sajda":false},{"v":32,"t":"حَدَآئِقَ وَأَعۡنَٰبٗا","juz":30,"page":583,"sajda":false},{"v":33,"t":"وَكَوَاعِبَ أَتۡرَابٗا","juz":30,"page":583,"sajda":false},{"v":34,"t":"وَكَأۡسٗا دِهَاقٗا","juz":30,"page":583,"sajda":false},{"v":35,"t":"لَّا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا كِذَّـٰبٗا","juz":30,"page":583,"sajda":false},{"v":36,"t":"جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَابٗا","juz":30,"page":583,"sajda":false},{"v":37,"t":"رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنِۖ لَا يَمۡلِكُونَ مِنۡهُ خِطَابٗا","juz":30,"page":583,"sajda":false},{"v":38,"t":"يَوۡمَ يَقُومُ ٱلرُّوحُ وَٱلۡمَلَـٰٓئِكَةُ صَفّٗاۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَقَالَ صَوَابٗا","juz":30,"page":583,"sajda":false},{"v":39,"t":"ذَٰلِكَ ٱلۡيَوۡمُ ٱلۡحَقُّۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا","juz":30,"page":583,"sajda":false},{"v":40,"t":"إِنَّآ أَنذَرۡنَٰكُمۡ عَذَابٗا قَرِيبٗا يَوۡمَ يَنظُرُ ٱلۡمَرۡءُ مَا قَدَّمَتۡ يَدَاهُ وَيَقُولُ ٱلۡكَافِرُ يَٰلَيۡتَنِي كُنتُ تُرَٰبَۢا","juz":30,"page":583,"sajda":false}]}