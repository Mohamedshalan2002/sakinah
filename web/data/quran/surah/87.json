{"surah":87,"verses":[{"v":1,"t":"سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى","juz":30,"page":591,"sajda":false},{"v":2,"t":"ٱلَّذِي خَلَقَ فَسَوَّىٰ","juz":30,"page":591,"sajda":false},{"v":3,"t":"وَٱلَّذِي قَدَّرَ فَهَدَىٰ","juz":30,"page":591,"sajda":false},{"v":4,"t":"وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ","juz":30,"page":591,"sajda":false},{"v":5,"t":"فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ","juz":30,"page":591,"sajda":false},{"v":6,"t":"سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ","juz":30,"page":591,"sajda":false},{"v":7,"t":"إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ","juz":30,"page":591,"sajda":false},{"v":8,"t":"وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ","juz":30,"page":591,"sajda":false},{"v":9,"t":"فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ","juz":30,"page":591,"sajda":false},{"v":10,"t":"سَيَذَّكَّرُ مَن يَخۡشَىٰ","juz":30,"page":591,"sajda":false},{"v":11,"t":"وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى","juz":30,"page":591,"sajda":false},{"v":12,"t":"ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ","juz":30,"page":591,"sajda":false},{"v":13,"t":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ","juz":30,"page":591,"sajda":false},{"v":14,"t":"قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ","juz":30,"page":591,"sajda":false},{"v":15,"t":"وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ","juz":30,"page":591,"sajda":false},{"v":16,"t":"بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا","juz":30,"page":592,"sajda":false},{"v":17,"t":"وَٱلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقَىٰٓ","juz":30,"page":592,"sajda":false},{"v":18,"t":"إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ","juz":30,"page":592,"sajda":false},{"v":19,"t":"صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ","juz":30,"page":592,"sajda":false}]}