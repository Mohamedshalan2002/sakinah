{"surah":106,"verses":[{"v":1,"t":"لِإِيلَٰفِ قُرَيۡشٍ","juz":30,"page":602,"sajda":false},{"v":2,"t":"إِۦلَٰفِهِمۡ رِحۡلَةَ ٱلشِّتَآءِ وَٱلصَّيۡفِ","juz":30,"page":602,"sajda":false},{"v":3,"t":"فَلۡيَعۡبُدُواْ رَبَّ هَٰذَا ٱلۡبَيۡتِ","juz":30,"page":602,"sajda":false},{"v":4,"t":"ٱلَّذِيٓ أَطۡعَمَهُم مِّن جُوعٖ وَءَامَنَهُم مِّنۡ خَوۡفِۭ","juz":30,"page":602,"sajda":false}]}