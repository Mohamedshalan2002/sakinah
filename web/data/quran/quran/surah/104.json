{"surah":104,"verses":[{"v":1,"t":"وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ","juz":30,"page":601,"sajda":false},{"v":2,"t":"ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ","juz":30,"page":601,"sajda":false},{"v":3,"t":"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ","juz":30,"page":601,"sajda":false},{"v":4,"t":"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ","juz":30,"page":601,"sajda":false},{"v":5,"t":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ","juz":30,"page":601,"sajda":false},{"v":6,"t":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ","juz":30,"page":601,"sajda":false},{"v":7,"t":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ","juz":30,"page":601,"sajda":false},{"v":8,"t":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ","juz":30,"page":601,"sajda":false},{"v":9,"t":"فِي عَمَدٖ مُّمَدَّدَةِۭ","juz":30,"page":601,"sajda":false}]}