{"surah":86,"verses":[{"v":1,"t":"وَٱلسَّمَآءِ وَٱلطَّارِقِ","juz":30,"page":591,"sajda":false},{"v":2,"t":"وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ","juz":30,"page":591,"sajda":false},{"v":3,"t":"ٱلنَّجۡمُ ٱلثَّاقِبُ","juz":30,"page":591,"sajda":false},{"v":4,"t":"إِن كُلُّ نَفۡسٖ لَّمَّا عَلَيۡهَا حَافِظٞ","juz":30,"page":591,"sajda":false},{"v":5,"t":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ","juz":30,"page":591,"sajda":false},{"v":6,"t":"خُلِقَ مِن مَّآءٖ دَافِقٖ","juz":30,"page":591,"sajda":false},{"v":7,"t":"يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ","juz":30,"page":591,"sajda":false},{"v":8,"t":"إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرٞ","juz":30,"page":591,"sajda":false},{"v":9,"t":"يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ","juz":30,"page":591,"sajda":false},{"v":10,"t":"فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖ","juz":30,"page":591,"sajda":false},{"v":11,"t":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ","juz":30,"page":591,"sajda":false},{"v":12,"t":"وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ","juz":30,"page":591,"sajda":false},{"v":13,"t":"إِنَّهُۥ لَقَوۡلٞ فَصۡلٞ","juz":30,"page":591,"sajda":false},{"v":14,"t":"وَمَا هُوَ بِٱلۡهَزۡلِ","juz":30,"page":591,"sajda":false},{"v":15,"t":"إِنَّهُمۡ يَكِيدُونَ كَيۡدٗا","juz":30,"page":591,"sajda":false},{"v":16,"t":"وَأَكِيدُ كَيۡدٗا","juz":30,"page":591,"sajda":false},{"v":17,"t":"فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا","juz":30,"page":591,"sajda":false}]}