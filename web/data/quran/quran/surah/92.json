{"surah":92,"verses":[{"v":1,"t":"وَٱلَّيۡلِ إِذَا يَغۡشَىٰ","juz":30,"page":595,"sajda":false},{"v":2,"t":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","juz":30,"page":595,"sajda":false},{"v":3,"t":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ","juz":30,"page":595,"sajda":false},{"v":4,"t":"إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ","juz":30,"page":595,"sajda":false},{"v":5,"t":"فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ","juz":30,"page":595,"sajda":false},{"v":6,"t":"وَصَدَّقَ بِٱلۡحُسۡنَىٰ","juz":30,"page":595,"sajda":false},{"v":7,"t":"فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ","juz":30,"page":595,"sajda":false},{"v":8,"t":"وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ","juz":30,"page":595,"sajda":false},{"v":9,"t":"وَكَذَّبَ بِٱلۡحُسۡنَىٰ","juz":30,"page":595,"sajda":false},{"v":10,"t":"فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ","juz":30,"page":595,"sajda":false},{"v":11,"t":"وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","juz":30,"page":595,"sajda":false},{"v":12,"t":"إِنَّ عَلَيۡنَا لَلۡهُدَىٰ","juz":30,"page":595,"sajda":false},{"v":13,"t":"وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ","juz":30,"page":595,"sajda":false},{"v":14,"t":"فَأَنذَرۡتُكُمۡ نَارٗا تَلَظَّىٰ","juz":30,"page":595,"sajda":false},{"v":15,"t":"لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى","juz":30,"page":596,"sajda":false},{"v":16,"t":"ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ","juz":30,"page":596,"sajda":false},{"v":17,"t":"وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى","juz":30,"page":596,"sajda":false},{"v":18,"t":"ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ","juz":30,"page":596,"sajda":false},{"v":19,"t":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزَىٰٓ","juz":30,"page":596,"sajda":false},{"v":20,"t":"إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ","juz":30,"page":596,"sajda":false},{"v":21,"t":"وَلَسَوۡفَ يَرۡضَىٰ","juz":30,"page":596,"sajda":false}]}