َّلِينَ وَٱلۡأٓخِرِينَ","juz":27,"page":535,"sajda":false},{"v":50,"t":"لَمَجۡمُوعُونَ إِلَىٰ مِيقَٰتِ يَوۡمٖ مَّعۡلُومٖ","juz":27,"page":535,"sajda":false},{"v":51,"t":"ثُمَّ إِنَّكُمۡ أَيُّهَا ٱلضَّآلُّونَ ٱلۡمُكَذِّبُونَ","juz":27,"page":536,"sajda":false},{"v":52,"t":"لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ","juz":27,"page":536,"sajda":false},{"v":53,"t":"فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ","juz":27,"page":536,"sajda":false},{"v":54,"t":"فَشَٰرِبُونَ عَلَيۡهِ مِنَ ٱلۡحَمِيمِ","juz":27,"page":536,"sajda":false},{"v":55,"t":"فَشَٰرِبُونَ شُرۡبَ ٱلۡهِيمِ","juz":27,"page":536,"sajda":false},{"v":56,"t":"هَٰذَا نُزُلُهُمۡ يَوۡمَ ٱلدِّينِ","juz":27,"page":536,"sajda":false},{"v":57,"t":"نَحۡنُ خَلَقۡنَٰكُمۡ فَلَوۡلَا تُصَدِّقُونَ","juz":27,"page":536,"sajda":false},{"v":58,"t":"أَفَرَءَيۡتُم مَّا تُمۡنُونَ","juz":27,"page":536,"sajda":false},{"v":59,"t":"ءَأَنتُمۡ تَخۡلُقُونَهُۥٓ أَمۡ نَحۡنُ ٱلۡخَٰلِقُونَ","juz":27,"page":536,"sajda":false},{"v":60,"t":"نَحۡنُ قَدَّرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ","juz":27,"page":536,"sajda":false},{"v":61,"t":"عَلَىٰٓ أَن نُّبَدِّلَ أَمۡثَٰلَكُمۡ وَنُنشِئَكُمۡ فِي مَا لَا تَعۡلَمُونَ","juz":27,"page":536,"sajda":false},{"v":62,"t":"وَلَقَدۡ عَلِمۡتُمُ ٱلنَّشۡأَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَكَّرُونَ","juz":27,"page":536,"sajda":false},{"v":63,"t":"أَفَرَءَيۡتُم مَّا تَحۡرُثُونَ","juz":27,"page":536,"sajda":false},{"v":64,"t":"ءَأَنتُمۡ تَزۡرَعُونَهُۥٓ أَمۡ نَحۡنُ ٱلزَّـٰرِعُونَ","juz":27,"page":536,"sajda":false},{"v":65,"t":"لَوۡ نَشَآءُ لَجَعَلۡنَٰهُ حُطَٰمٗا فَظَلۡتُمۡ تَفَكَّهُونَ","juz":27,"page":536,"sajda":false},{"v":66,"t":"إِنَّا لَمُغۡرَمُونَ","juz":27,"page":536,"sajda":false},{"v":67,"t":"بَلۡ نَحۡنُ مَحۡرُومُونَ","juz":27,"page":536,"sajda":false},{"v":68,"t":"أَفَرَءَيۡتُمُ ٱلۡمَآءَ ٱلَّذِي تَشۡرَبُونَ","juz":27,"page":536,"sajda":false},{"v":69,"t":"ءَأَنتُمۡ أَنزَلۡتُمُوهُ مِنَ ٱلۡمُزۡنِ أَمۡ نَحۡنُ ٱلۡمُنزِلُونَ","juz":27,"page":536,"sajda":false},{"v":70,"t":"لَوۡ نَشَآءُ جَعَلۡنَٰهُ أُجَاجٗا فَل