{"surah":88,"verses":[{"v":1,"t":"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ","juz":30,"page":592,"sajda":false},{"v":2,"t":"وُجُوهٞ يَوۡمَئِذٍ خَٰشِعَةٌ","juz":30,"page":592,"sajda":false},{"v":3,"t":"عَامِلَةٞ نَّاصِبَةٞ","juz":30,"page":592,"sajda":false},{"v":4,"t":"تَصۡلَىٰ نَارًا حَامِيَةٗ","juz":30,"page":592,"sajda":false},{"v":5,"t":"تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةٖ","juz":30,"page":592,"sajda":false},{"v":6,"t":"لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعٖ","juz":30,"page":592,"sajda":false},{"v":7,"t":"لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعٖ","juz":30,"page":592,"sajda":false},{"v":8,"t":"وُجُوهٞ يَوۡمَئِذٖ نَّاعِمَةٞ","juz":30,"page":592,"sajda":false},{"v":9,"t":"لِّسَعۡيِهَا رَاضِيَةٞ","juz":30,"page":592,"sajda":false},{"v":10,"t":"فِي جَنَّةٍ عَالِيَةٖ","juz":30,"page":592,"sajda":false},{"v":11,"t":"لَّا تَسۡمَعُ فِيهَا لَٰغِيَةٗ","juz":30,"page":592,"sajda":false},{"v":12,"t":"فِيهَا عَيۡنٞ جَارِيَةٞ","juz":30,"page":592,"sajda":false},{"v":13,"t":"فِيهَا سُرُرٞ مَّرۡفُوعَةٞ","juz":30,"page":592,"sajda":false},{"v":14,"t":"وَأَكۡوَابٞ مَّوۡضُوعَةٞ","juz":30,"page":592,"sajda":false},{"v":15,"t":"وَنَمَارِقُ مَصۡفُوفَةٞ","juz":30,"page":592,"sajda":false},{"v":16,"t":"وَزَرَابِيُّ مَبۡثُوثَةٌ","juz":30,"page":592,"sajda":false},{"v":17,"t":"أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ","juz":30,"page":592,"sajda":false},{"v":18,"t":"وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ","juz":30,"page":592,"sajda":false},{"v":19,"t":"وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ","juz":30,"page":592,"sajda":false},{"v":20,"t":"وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ","juz":30,"page":592,"sajda":false},{"v":21,"t":"فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرٞ","juz":30,"page":592,"sajda":false},{"v":22,"t":"لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ","juz":30,"page":592,"sajda":false},{"v":23,"t":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","juz":30,"page":592,"sajda":false},{"v":24,"t":"فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ","juz":30,"page":592,"sajda":false},{"v":25,"t":"إِنَّ إِلَيۡنَآ إِيَابَهُمۡ","juz":30,"page":5