{"surah":79,"verses":[{"v":1,"t":"وَٱلنَّـٰزِعَٰتِ غَرۡقٗا","juz":30,"page":583,"sajda":false},{"v":2,"t":"وَٱلنَّـٰشِطَٰتِ نَشۡطٗا","juz":30,"page":583,"sajda":false},{"v":3,"t":"وَٱلسَّـٰبِحَٰتِ سَبۡحٗا","juz":30,"page":583,"sajda":false},{"v":4,"t":"فَٱلسَّـٰبِقَٰتِ سَبۡقٗا","juz":30,"page":583,"sajda":false},{"v":5,"t":"فَٱلۡمُدَبِّرَٰتِ أَمۡرٗا","juz":30,"page":583,"sajda":false},{"v":6,"t":"يَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ","juz":30,"page":583,"sajda":false},{"v":7,"t":"تَتۡبَعُهَا ٱلرَّادِفَةُ","juz":30,"page":583,"sajda":false},{"v":8,"t":"قُلُوبٞ يَوۡمَئِذٖ وَاجِفَةٌ","juz":30,"page":583,"sajda":false},{"v":9,"t":"أَبۡصَٰرُهَا خَٰشِعَةٞ","juz":30,"page":583,"sajda":false},{"v":10,"t":"يَقُولُونَ أَءِنَّا لَمَرۡدُودُونَ فِي ٱلۡحَافِرَةِ","juz":30,"page":583,"sajda":false},{"v":11,"t":"أَءِذَا كُنَّا عِظَٰمٗا نَّخِرَةٗ","juz":30,"page":583,"sajda":false},{"v":12,"t":"قَالُواْ تِلۡكَ إِذٗا كَرَّةٌ خَاسِرَةٞ","juz":30,"page":583,"sajda":false},{"v":13,"t":"فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ","juz":30,"page":583,"sajda":false},{"v":14,"t":"فَإِذَا هُم بِٱلسَّاهِرَةِ","juz":30,"page":583,"sajda":false},{"v":15,"t":"هَلۡ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","juz":30,"page":583,"sajda":false},{"v":16,"t":"إِذۡ نَادَىٰهُ رَبُّهُۥ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوًى","juz":30,"page":584,"sajda":false},{"v":17,"t":"ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ","juz":30,"page":584,"sajda":false},{"v":18,"t":"فَقُلۡ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ","juz":30,"page":584,"sajda":false},{"v":19,"t":"وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشَىٰ","juz":30,"page":584,"sajda":false},{"v":20,"t":"فَأَرَىٰهُ ٱلۡأٓيَةَ ٱلۡكُبۡرَىٰ","juz":30,"page":584,"sajda":false},{"v":21,"t":"فَكَذَّبَ وَعَصَىٰ","juz":30,"page":584,"sajda":false},{"v":22,"t":"ثُمَّ أَدۡبَرَ يَسۡعَىٰ","juz":30,"page":584,"sajda":false},{"v":23,"t":"فَحَشَرَ فَنَادَىٰ","juz":30,"page":584,"sajda":false},{"v":24,"t":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ","juz":30,"page":584,"sajda":false},{"v":25,"t":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡأٓخِرَةِ وَٱلۡأُولَىٰٓ","juz":30,"page":584,"sajda":false},{"v":26,"t":"إِنَّ فِي ذَٰلِكَ لَعِبۡرَةٗ لِّمَن يَخۡشَىٰٓ","juz":30,"page":584,"sajda":false},{"v":27,"t":"ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَآءُۚ بَنَىٰهَا","juz":30,"page":584,"sajda":false},{"v":28,"t":"رَفَعَ سَمۡكَهَا فَسَوَّىٰهَا","juz":30,"page":584,"sajda":false},{"v":29,"t":"وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحَىٰهَا","juz":30,"page":584,"sajda":false},{"v":30,"t":"وَٱلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحَىٰهَآ","juz":30,"page":584,"sajda":false},{"v":31,"t":"أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعَىٰهَا","juz":30,"page":584,"sajda":false},{"v":32,"t":"وَٱلۡجِبَالَ أَرۡسَىٰهَا","juz":30,"page":584,"sajda":false},{"v":33,"t":"مَتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ","juz":30,"page":584,"sajda":false},{"v":34,"t":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلۡكُبۡرَىٰ","juz":30,"page":584,"sajda":false},{"v":35,"t":"يَوۡمَ يَتَذَكَّرُ ٱلۡإِنسَٰنُ مَا سَعَىٰ","juz":30,"page":584,"sajda":false},{"v":36,"t":"وَبُرِّزَتِ ٱلۡجَحِيمُ لِمَن يَرَىٰ","juz":30,"page":584,"sajda":false},{"v":37,"t":"فَأَمَّا مَن طَغَىٰ","juz":30,"page":584,"sajda":false},{"v":38,"t":"وَءَاثَرَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا","juz":30,"page":584,"sajda":false},{"v":39,"t":"فَإِنَّ ٱلۡجَحِيمَ هِيَ ٱلۡمَأۡوَىٰ","juz":30,"page":584,"sajda":false},{"v":40,"t":"وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىٰ","juz":30,"page":584,"sajda":false},{"v":41,"t":"فَإِنَّ ٱلۡجَنَّةَ هِيَ ٱلۡمَأۡوَىٰ","juz":30,"page":584,"sajda":false},{"v":42,"t":"يَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرۡسَىٰهَا","juz":30,"page":584,"sajda":false},{"v":43,"t":"فِيمَ أَنتَ مِن ذِكۡرَىٰهَآ","juz":30,"page":584,"sajda":false},{"v":44,"t":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ","juz":30,"page":584,"sajda":false},{"v":45,"t":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخۡشَىٰهَا","juz":30,"page":584,"sajda":false},{"v":46,"t":"كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوٓاْ إِلَّا عَشِيَّةً أَوۡ ضُحَىٰهَا","juz":30,"page":584,"sajda":false}]}