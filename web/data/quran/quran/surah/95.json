{"surah":95,"verses":[{"v":1,"t":"وَٱلتِّينِ وَٱلزَّيۡتُونِ","juz":30,"page":597,"sajda":false},{"v":2,"t":"وَطُورِ سِينِينَ","juz":30,"page":597,"sajda":false},{"v":3,"t":"وَهَٰذَا ٱلۡبَلَدِ ٱلۡأَمِينِ","juz":30,"page":597,"sajda":false},{"v":4,"t":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِيٓ أَحۡسَنِ تَقۡوِيمٖ","juz":30,"page":597,"sajda":false},{"v":5,"t":"ثُمَّ رَدَدۡنَٰهُ أَسۡفَلَ سَٰفِلِينَ","juz":30,"page":597,"sajda":false},{"v":6,"t":"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ فَلَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونٖ","juz":30,"page":597,"sajda":false},{"v":7,"t":"فَمَا يُكَذِّبُكَ بَعۡدُ بِٱلدِّينِ","juz":30,"page":597,"sajda":false},{"v":8,"t":"أَلَيۡسَ ٱللَّهُ بِأَحۡكَمِ ٱلۡحَٰكِمِينَ","juz":30,"page":597,"sajda":false}]}