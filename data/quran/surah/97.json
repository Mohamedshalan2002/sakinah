{"surah":97,"verses":[{"v":1,"t":"إِنَّآ أَنزَلۡنَٰهُ فِي لَيۡلَةِ ٱلۡقَدۡرِ","juz":30,"page":598,"sajda":false},{"v":2,"t":"وَمَآ أَدۡرَىٰكَ مَا لَيۡلَةُ ٱلۡقَدۡرِ","juz":30,"page":598,"sajda":false},{"v":3,"t":"لَيۡلَةُ ٱلۡقَدۡرِ خَيۡرٞ مِّنۡ أَلۡفِ شَهۡرٖ","juz":30,"page":598,"sajda":false},{"v":4,"t":"تَنَزَّلُ ٱلۡمَلَـٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذۡنِ رَبِّهِم مِّن كُلِّ أَمۡرٖ","juz":30,"page":598,"sajda":false},{"v":5,"t":"سَلَٰمٌ هِيَ حَتَّىٰ مَطۡلَعِ ٱلۡفَجۡرِ","juz":30,"page":598,"sajda":false}]}