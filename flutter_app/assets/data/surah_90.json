{"surah":90,"verses":[{"v":1,"t":"لَآ أُقۡسِمُ بِهَٰذَا ٱلۡبَلَدِ","juz":30,"page":594,"sajda":false},{"v":2,"t":"وَأَنتَ حِلُّۢ بِهَٰذَا ٱلۡبَلَدِ","juz":30,"page":594,"sajda":false},{"v":3,"t":"وَوَالِدٖ وَمَا وَلَدَ","juz":30,"page":594,"sajda":false},{"v":4,"t":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِي كَبَدٍ","juz":30,"page":594,"sajda":false},{"v":5,"t":"أَيَحۡسَبُ أَن لَّن يَقۡدِرَ عَلَيۡهِ أَحَدٞ","juz":30,"page":594,"sajda":false},{"v":6,"t":"يَقُولُ أَهۡلَكۡتُ مَالٗا لُّبَدًا","juz":30,"page":594,"sajda":false},{"v":7,"t":"أَيَحۡسَبُ أَن لَّمۡ يَرَهُۥٓ أَحَدٌ","juz":30,"page":594,"sajda":false},{"v":8,"t":"أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ","juz":30,"page":594,"sajda":false},{"v":9,"t":"وَلِسَانٗا وَشَفَتَيۡنِ","juz":30,"page":594,"sajda":false},{"v":10,"t":"وَهَدَيۡنَٰهُ ٱلنَّجۡدَيۡنِ","juz":30,"page":594,"sajda":false},{"v":11,"t":"فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ","juz":30,"page":594,"sajda":false},{"v":12,"t":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡعَقَبَةُ","juz":30,"page":594,"sajda":false},{"v":13,"t":"فَكُّ رَقَبَةٍ","juz":30,"page":594,"sajda":false},{"v":14,"t":"أَوۡ إِطۡعَٰمٞ فِي يَوۡمٖ ذِي مَسۡغَبَةٖ","juz":30,"page":594,"sajda":false},{"v":15,"t":"يَتِيمٗا ذَا مَقۡرَبَةٍ","juz":30,"page":594,"sajda":false},{"v":16,"t":"أَوۡ مِسۡكِينٗا ذَا مَتۡرَبَةٖ","juz":30,"page":594,"sajda":false},{"v":17,"t":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُواْ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ وَتَوَاصَوۡاْ بِٱلۡمَرۡحَمَةِ","juz":30,"page":594,"sajda":false},{"v":18,"t":"أُوْلَـٰٓئِكَ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ","juz":30,"page":594,"sajda":false},{"v":19,"t":"وَٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمۡ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ","juz":30,"page":594,"sajda":false},{"v":20,"t":"عَلَيۡهِمۡ نَارٞ مُّؤۡصَدَةُۢ","juz":30,"page":594,"sajda":false}]}