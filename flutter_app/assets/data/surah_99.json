{"surah":99,"verses":[{"v":1,"t":"إِذَا زُلۡزِلَتِ ٱلۡأَرۡضُ زِلۡزَالَهَا","juz":30,"page":599,"sajda":false},{"v":2,"t":"وَأَخۡرَجَتِ ٱلۡأَرۡضُ أَثۡقَالَهَا","juz":30,"page":599,"sajda":false},{"v":3,"t":"وَقَالَ ٱلۡإِنسَٰنُ مَا لَهَا","juz":30,"page":599,"sajda":false},{"v":4,"t":"يَوۡمَئِذٖ تُحَدِّثُ أَخۡبَارَهَا","juz":30,"page":599,"sajda":false},{"v":5,"t":"بِأَنَّ رَبَّكَ أَوۡحَىٰ لَهَا","juz":30,"page":599,"sajda":false},{"v":6,"t":"يَوۡمَئِذٖ يَصۡدُرُ ٱلنَّاسُ أَشۡتَاتٗا لِّيُرَوۡاْ أَعۡمَٰلَهُمۡ","juz":30,"page":599,"sajda":false},{"v":7,"t":"فَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةٍ خَيۡرٗا يَرَهُۥ","juz":30,"page":599,"sajda":false},{"v":8,"t":"وَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةٖ شَرّٗا يَرَهُۥ","juz":30,"page":599,"sajda":false}]}