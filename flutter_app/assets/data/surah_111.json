{"surah":111,"verses":[{"v":1,"t":"تَبَّتۡ يَدَآ أَبِي لَهَبٖ وَتَبَّ","juz":30,"page":603,"sajda":false},{"v":2,"t":"مَآ أَغۡنَىٰ عَنۡهُ مَالُهُۥ وَمَا كَسَبَ","juz":30,"page":603,"sajda":false},{"v":3,"t":"سَيَصۡلَىٰ نَارٗا ذَاتَ لَهَبٖ","juz":30,"page":603,"sajda":false},{"v":4,"t":"وَٱمۡرَأَتُهُۥ حَمَّالَةَ ٱلۡحَطَبِ","juz":30,"page":603,"sajda":false},{"v":5,"t":"فِي جِيدِهَا حَبۡلٞ مِّن مَّسَدِۭ","juz":30,"page":603,"sajda":false}]}